# --- CoinGecko (free Demo API key, optional: https://www.coingecko.com/en/api) ---
COINGECKO_API_KEY=
COINGECKO_API_URL=https://api.coingecko.com/api/v3/coins/markets
# Free tier is ~30 calls/min and 10,000 calls/month; 300s (~8,640 calls/month) stays under it.
POLL_INTERVAL_SECONDS=300

# --- PostgreSQL (destination) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=coingecko
POSTGRES_PORT=5432

# --- Kafka (KRaft mode) ---
KAFKA_PORT=9092
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# --- Schema Registry ---
SCHEMA_REGISTRY_PORT=8081

# --- AKHQ ---
AKHQ_PORT=8080

# --- Metabase ---
METABASE_PORT=3000
